<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- liquid
    assign favicon_source = settings.favicon
    if favicon_source == blank
      assign favicon_source = settings.seal_on_dark | default: settings.seal_on_light
    endif
  -%}
  {%- if favicon_source -%}<link rel="icon" type="image/png" href="{{ favicon_source | image_url: width: 96 }}">{%- else -%}<link rel="icon" href="data:,">{%- endif -%}
  {{ 'caviera-base.css' | asset_url | stylesheet_tag }}
  {{ 'caviera-layout.css' | asset_url | stylesheet_tag }}
  {{ 'caviera-components.css' | asset_url | stylesheet_tag }}
  {% style %}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_display | font_face: font_display: 'swap' }}
  {% endstyle %}
  <style>
    :root{
      --font-display: {{ settings.font_display.family }}, "Cormorant", Georgia, serif;
      --font-body: {{ settings.font_body.family }}, "Helvetica Neue", Helvetica, Arial, sans-serif;
      --caviera-cinnabar: {{ settings.color_cinnabar | default: '#8F261F' }};
      --caviera-bone: {{ settings.color_bone | default: '#F3EEE5' }};
      --caviera-obsidian: {{ settings.color_obsidian | default: '#111012' }};
    }
    body { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; justify-content: center; background: var(--caviera-obsidian); color: var(--caviera-bone); text-align: center; }
    .caviera-password { max-width: 460px; padding: var(--gutter-mobile); }
    .caviera-password__mark { max-width: 260px; margin: 0 auto 40px; }
    .caviera-password__form { display: flex; gap: 12px; margin-top: 28px; }
    .caviera-password__form input { flex: 1; border: 1px solid var(--border-subtle-on-dark); background: transparent; color: var(--caviera-bone); padding: 12px; }
    .caviera-password__admin { margin-top: 20px; }
    .caviera-password__admin a { color: var(--caviera-rhodium); font-size: 0.8125rem; }
  </style>
  {{ content_for_header }}
</head>
<body>
  <main class="caviera-password">
    <div class="caviera-password__mark">
      {%- render 'caviera-master-signature', mode: 'dark', width: 260 -%}
    </div>
    <h1 class="eyebrow">{{ 'templates.password.opening_soon' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="body-text">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      <div class="caviera-password__form">
        <label class="visually-hidden" for="PasswordInput">{{ 'templates.password.password_placeholder' | t }}</label>
        <input type="password" id="PasswordInput" name="password" placeholder="{{ 'templates.password.password_placeholder' | t }}" required>
        <button type="submit" class="btn btn--primary">{{ 'templates.password.password_submit' | t }}</button>
      </div>
      {%- if form.errors -%}<p class="form-status" data-state="error">{{ form.errors.messages['form'] }}</p>{%- endif -%}
    {%- endform -%}

    <p class="caviera-password__admin"><a href="{{ routes.account_login_url }}">{{ 'templates.password.admin_link' | t }}</a></p>
  </main>
  {{ content_for_layout }}
</body>
</html>
