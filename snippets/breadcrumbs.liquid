{%- comment -%} Accessible breadcrumb trail + BreadcrumbList structured data. {%- endcomment -%}
<nav class="caviera-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ shop.name }}</a></li>
    {%- if template.name == 'product' -%}
      {%- if collection.url -%}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{%- endif -%}
      <li aria-current="page">{{ product.title }}</li>
    {%- elsif template.name == 'collection' -%}
      <li aria-current="page">{{ collection.title }}</li>
    {%- elsif template.name == 'blog' -%}
      <li aria-current="page">{{ blog.title }}</li>
    {%- elsif template.name == 'article' -%}
      <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
      <li aria-current="page">{{ article.title }}</li>
    {%- elsif page -%}
      <li aria-current="page">{{ page.title }}</li>
    {%- endif -%}
  </ol>
</nav>
{%- if template.name == 'product' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
    {%- if collection.url -%}, { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }{%- endif -%}
    , { "@type": "ListItem", "position": {% if collection.url %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
  ]
}
</script>
{%- endif -%}
