{%- comment -%}
  Renders the official full CAVIERA JEWELS wordmark. This is proprietary artwork — it is never
  retyped, redrawn, or substituted with a font.

  Priority: 1) merchant-selected Theme Editor image, 2) approved bundled CAVIERA wordmark
  (assets/caviera-full-logo-*.png — official House artwork shipped with the theme), 3) if somehow
  neither resolves, nothing renders on the storefront and a discreet reminder appears only inside
  the Theme Editor.

  Params:
    mode: 'light' | 'dark' — which background this mark sits on (default 'light')
    css_class: optional extra classes
    width: optional max-width in px (never render below ~180px per brand rules; caller should
           ensure surrounding layout respects this)
{%- endcomment -%}
{%- liquid
  assign mode = mode | default: 'light'
  assign asset = settings.wordmark_on_light
  assign bundled_file = 'caviera-full-logo-obsidian.png'
  assign bundled_w = 3000
  assign bundled_h = 557
  assign setting_label = 'Wordmark on light — Theme settings → CAVIERA Identity'
  if mode == 'dark'
    assign asset = settings.wordmark_on_dark
    assign bundled_file = 'caviera-full-logo-warm-bone.png'
    assign setting_label = 'Wordmark on dark — Theme settings → CAVIERA Identity'
  endif
-%}
{%- if asset -%}
  <img
    class="caviera-wordmark {{ css_class }}"
    src="{{ asset | image_url: width: 800 }}"
    srcset="{{ asset | image_url: width: 400 }} 400w, {{ asset | image_url: width: 800 }} 800w, {{ asset | image_url: width: 1200 }} 1200w"
    sizes="(min-width: 1024px) 280px, 200px"
    width="{{ asset.width }}"
    height="{{ asset.height }}"
    alt="{{ shop.name }}"
    loading="{{ loading | default: 'lazy' }}"
    {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    style="{% if width %}max-width:{{ width }}px;{% endif %} height:auto; width:100%;"
  >
{%- elsif bundled_file -%}
  <img
    class="caviera-wordmark {{ css_class }}"
    src="{{ bundled_file | asset_url }}"
    width="{{ bundled_w }}"
    height="{{ bundled_h }}"
    alt="{{ shop.name }}"
    loading="{{ loading | default: 'lazy' }}"
    {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
    style="{% if width %}max-width:{{ width }}px;{% endif %} height:auto; width:100%;"
  >
{%- elsif request.design_mode -%}
  <span class="caviera-asset-placeholder" role="presentation">
    Upload: {{ setting_label }}
  </span>
{%- endif -%}
