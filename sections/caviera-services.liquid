{%- comment -%}
  Quiet trust signals. Fully merchant-editable — nothing is hard-coded globally, no loud badges.

  STATIC — PERMANENT (final decision, locked): multiple animation architectures were tried for
  this heading/column reveal (a shared one-shot reveal, an IntersectionObserver entrance-trigger
  controller, and a direct scroll-progress rAF controller). None was ever confirmed perceptible in
  real-browser testing, and this environment has no browser to close that gap. Following a
  regression scare on the wider site (investigated and found, via exhaustive diff against the
  deployed remote theme, to involve zero changes to any other section's JS/CSS — see the "Restore
  CAVIERA signature animation systems" commit for the full audit), this section is being locked to
  its plain, always fully-visible static state permanently. Do not attempt another animation pass.
{%- endcomment -%}
{%- liquid
  assign has_items = false
  for block in section.blocks
    if block.settings.title != blank
      assign has_items = true
    endif
  endfor
-%}
{%- if has_items -%}
<section class="caviera-section caviera-section--tight caviera-services">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="heading-h3 caviera-services__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="caviera-services__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          <li class="caviera-services__item" {{ block.shopify_attributes }}>
            <h3 class="label">{{ block.settings.title }}</h3>
            {%- if block.settings.body != blank -%}<p class="body-text">{{ block.settings.body }}</p>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="caviera-section caviera-section--tight"><div class="container"><div class="caviera-editor-note">Add service blocks (e.g. Made to order, Tracked delivery, Client support).</div></div></section>
{%- endif -%}

{% schema %}
{
  "name": "House services",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In service of the object" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "House services",
      "blocks": [
        { "type": "service", "settings": { "title": "Made to order" } },
        { "type": "service", "settings": { "title": "Tracked delivery" } },
        { "type": "service", "settings": { "title": "Client support" } }
      ]
    }
  ]
}
{% endschema %}
