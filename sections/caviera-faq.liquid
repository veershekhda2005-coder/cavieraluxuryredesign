{%- comment -%}
  Accessible FAQ accordion. Merchant-entered content only. Supports optional named groups via
  "Group heading" blocks interspersed among "Question" blocks (e.g. Orders, Delivery, Care) — a
  group heading with no questions under it before the next heading (or the end) simply has nothing
  to show beneath it, so there's nothing to hide separately. Each question is deep-linkable via
  its block id.
{%- endcomment -%}
<section class="caviera-section container container--narrow caviera-faq">
  {%- if section.settings.heading != blank -%}<h2 class="heading-h2">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="caviera-faq__list">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'group_heading' -%}
          {%- if block.settings.title != blank -%}
            <h2 class="heading-h3 caviera-faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h2>
          {%- endif -%}
        {%- when 'question' -%}
          {%- if block.settings.question != blank -%}
            <details class="caviera-faq__item" id="faq-{{ block.id }}" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span class="caviera-faq__icon">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="caviera-faq__answer body-text">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" }
  ],
  "blocks": [
    {
      "type": "group_heading",
      "name": "Group heading",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "info": "e.g. Orders, Jewellery, Sizing, Delivery, Returns, Care, Bespoke — optional, purely organisational." }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }
  ]
}
{% endschema %}
