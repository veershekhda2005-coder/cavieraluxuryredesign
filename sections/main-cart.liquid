{%- comment -%} Full cart page — works identically without JavaScript (native form posts to /cart). {%- endcomment -%}
<section class="caviera-cart-page container">
  <h1 class="heading-h1">{{ 'general.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="caviera-cart-page__empty">
      <p class="body-text">{{ 'general.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="btn btn--primary">{{ 'general.cart.empty_action' | t }}</a>
    </div>
  {%- else -%}
    {%- form 'cart', cart, class: 'caviera-cart-page__form' -%}
      <table class="caviera-cart-page__table">
        <thead>
          <tr>
            <th scope="col">{{ 'products.product.description' | t }}</th>
            <th scope="col">{{ 'general.cart.quantity' | t }}</th>
            <th scope="col">{{ 'general.cart.subtotal' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="caviera-cart-page__row">
              <td>
                <div class="caviera-cart-page__item">
                  <a href="{{ item.url }}" class="caviera-cart-page__item-media">
                    {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" width="100" height="100" alt="{{ item.image.alt | default: item.title | escape }}" loading="lazy">{%- endif -%}
                  </a>
                  <div>
                    <a href="{{ item.url }}" class="caviera-cart-page__item-title">{{ item.product.title }}</a>
                    {%- unless item.variant.title == 'Default Title' -%}<p class="label">{{ item.variant.title }}</p>{%- endunless -%}
                    {%- render 'product-price', variant: item.variant -%}
                    <button type="submit" name="updates[{{ forloop.index }}]" value="0" class="link-underline caviera-cart-page__remove">{{ 'general.cart.remove' | t }}</button>
                  </div>
                </div>
              </td>
              <td data-label="{{ 'general.cart.quantity' | t }}">
                <label class="visually-hidden" for="CartQuantity-{{ forloop.index }}">{{ 'general.cart.quantity' | t }}</label>
                <input type="number" id="CartQuantity-{{ forloop.index }}" name="updates[{{ forloop.index }}]" value="{{ item.quantity }}" min="0" inputmode="numeric">
              </td>
              <td data-label="{{ 'general.cart.subtotal' | t }}">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      {%- if settings.cart_note_enabled -%}
        <div class="field">
          <label for="CartNote">{{ 'general.cart.note' | t }}</label>
          <textarea id="CartNote" name="note" placeholder="{{ 'general.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
        </div>
      {%- endif -%}

      {%- if cart.cart_level_discount_applications.size > 0 -%}
        <ul class="caviera-cart-page__discounts">
          {%- for discount in cart.cart_level_discount_applications -%}
            <li>{{ discount.title }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="caviera-cart-page__summary">
        <span>{{ 'general.cart.subtotal' | t }}</span>
        <span class="price">{{ cart.total_price | money }}</span>
      </div>
      <p class="label">{{ 'general.cart.taxes_included_shipping_at_checkout' | t }}</p>

      <div class="caviera-cart-page__actions">
        <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="link-underline caviera-cart-page__continue">{{ 'general.cart.continue_shopping' | t }}</a>
        <button type="submit" name="update" class="btn">{{ 'general.cart.update' | t }}</button>
        <button type="submit" name="checkout" class="btn btn--primary">{{ 'general.cart.checkout' | t }}</button>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart page" }
{% endschema %}
