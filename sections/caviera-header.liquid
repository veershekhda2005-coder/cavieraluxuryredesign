{%- comment -%}
  Global header. Desktop: spacious, optionally transparent over a hero, compacts on scroll and may
  swap the full wordmark for the House Seal. Mobile: House Seal + full-screen drawer. Menu content
  is entirely merchant-driven via a Shopify linklist — nothing here is hardcoded.

  Controlled-visual-test revision: architecture is now MENU / WORDMARK / SEARCH · BAG at every
  breakpoint (Drkst-style restraint) — the inline desktop nav + hover mega menu below is retired
  from view (kept in markup, permanently hidden via CSS in assets/caviera-header.css, so a
  merchant's existing "Menu" linklist and any "Mega menu feature" blocks are never lost, only
  unused for now). The single `data-caviera-menu-toggle` button opens the SAME full-screen
  environment — previously mobile-only — at every breakpoint, so nothing about a merchant's
  configured navigation actually changes: `main_menu` and `mobile_secondary_menu` still drive it.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.main_menu
  assign transparent = section.settings.transparent_over_hero
  assign sticky = section.settings.sticky_header
  assign sticky_logo_mode = section.settings.sticky_logo_mode
  assign resolved_scheme = section.settings.resolved_scheme | default: 'bone'
  assign logo_scheme = section.settings.logo_scheme | default: 'light'
-%}
<caviera-header
  class="caviera-header{% if transparent %} caviera-header--transparent{% endif %}"
  data-sticky="{{ sticky }}"
  data-sticky-logo-mode="{{ sticky_logo_mode }}"
  data-resolved-scheme="{{ resolved_scheme }}"
  data-logo-scheme="{{ logo_scheme }}"
  role="banner"
>
  <div class="caviera-header__bar container">
    <button type="button" class="caviera-header__menu-toggle" data-caviera-menu-toggle aria-expanded="false" aria-controls="caviera-mobile-nav">
      <span class="caviera-header__menu-label">{{ 'sections.header.menu' | t }}</span>
    </button>

    <a href="{{ routes.root_url }}" class="caviera-header__logo" aria-label="{{ shop.name }} — {{ 'general.accessibility.home' | t }}">
      <span class="caviera-header__logo-full">
        {%- render 'caviera-wordmark', mode: section.settings.logo_scheme, loading: 'eager', fetchpriority: 'high', width: section.settings.logo_width_desktop -%}
      </span>
      <span class="caviera-header__logo-compact">
        {%- render 'caviera-house-seal', mode: section.settings.logo_scheme, loading: 'eager', width: section.settings.logo_width_mobile, alt: '' -%}
      </span>
    </a>

    {%- if menu != blank -%}
    <nav class="caviera-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul>
        {%- for link in menu.links -%}
          <li class="caviera-header__nav-item{% if link.links != blank %} has-submenu{% endif %}">
            {%- if link.links != blank -%}
              {%- liquid
                assign feature_block = nil
                for block in section.blocks
                  if block.type == 'megamenu_feature' and block.settings.match_title != blank and block.settings.match_title == link.title
                    assign feature_block = block
                  endif
                endfor
              -%}
              <button type="button" class="caviera-header__nav-link" aria-expanded="false" aria-haspopup="true">
                {{ link.title }}
                {% render 'icon', name: 'chevron-down' %}
              </button>
              <div class="caviera-header__megamenu">
                <div class="caviera-header__megamenu-columns">
                  {%- for child in link.links -%}
                    <div class="caviera-header__megamenu-column">
                      <a href="{{ child.url }}" class="caviera-header__megamenu-heading">{{ child.title }}</a>
                      {%- if child.links != blank -%}
                        <ul>
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                  {%- if feature_block -%}
                    {%- liquid
                      assign feature_url = nil
                      assign feature_title = nil
                      assign feature_image = feature_block.settings.image
                      case feature_block.settings.feature_type
                        when 'collection'
                          assign feature_url = feature_block.settings.collection.url
                          assign feature_title = feature_block.settings.collection.title
                          if feature_image == blank
                            assign feature_image = feature_block.settings.collection.featured_image
                          endif
                        when 'article'
                          assign feature_url = feature_block.settings.article.url
                          assign feature_title = feature_block.settings.article.title
                          if feature_image == blank
                            assign feature_image = feature_block.settings.article.image
                          endif
                      endcase
                    -%}
                    {%- if feature_image != blank -%}
                      <a
                        href="{{ feature_url | default: '#' }}"
                        class="caviera-header__megamenu-editorial"
                        {{ feature_block.shopify_attributes }}
                      >
                        <img
                          src="{{ feature_image | image_url: width: 640 }}"
                          srcset="{{ feature_image | image_url: width: 320 }} 320w, {{ feature_image | image_url: width: 640 }} 640w"
                          sizes="320px"
                          width="{{ feature_image.width }}"
                          height="{{ feature_image.height }}"
                          alt="{{ feature_image.alt | default: feature_title | default: '' | escape }}"
                          loading="lazy"
                        >
                        {%- if feature_title != blank -%}<span class="caviera-header__megamenu-editorial-label">{{ feature_title }}</span>{%- endif -%}
                      </a>
                    {%- endif -%}
                  {%- elsif section.settings.megamenu_image -%}
                    <div class="caviera-header__megamenu-editorial">
                      <img
                        src="{{ section.settings.megamenu_image | image_url: width: 640 }}"
                        srcset="{{ section.settings.megamenu_image | image_url: width: 320 }} 320w, {{ section.settings.megamenu_image | image_url: width: 640 }} 640w"
                        sizes="320px"
                        width="{{ section.settings.megamenu_image.width }}"
                        height="{{ section.settings.megamenu_image.height }}"
                        alt="{{ section.settings.megamenu_image.alt | default: '' | escape }}"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="caviera-header__nav-link">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    {%- endif -%}

    <div class="caviera-header__actions">
      {%- if section.settings.enable_search -%}
        {%- if settings.predictive_search_enabled -%}
        <button type="button" class="caviera-header__action" data-caviera-search-toggle aria-haspopup="dialog">
          {% render 'icon', name: 'search' %}
          <span class="visually-hidden">{{ 'sections.header.search' | t }}</span>
        </button>
        {%- else -%}
        <a href="{{ routes.search_url }}" class="caviera-header__action">
          {% render 'icon', name: 'search' %}
          <span class="visually-hidden">{{ 'sections.header.search' | t }}</span>
        </a>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.enable_account and shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="caviera-header__action">
        {% render 'icon', name: 'account' %}
        <span class="visually-hidden">{{ 'sections.header.account' | t }}</span>
      </a>
      {%- endif -%}

      <button type="button" class="caviera-header__action caviera-header__cart" data-caviera-cart-toggle aria-haspopup="dialog">
        {% render 'icon', name: 'bag' %}
        <span class="visually-hidden" data-cart-label>
          {%- if cart.item_count > 0 -%}
            {%- if cart.item_count == 1 -%}
              {{ 'sections.header.cart_count.one' | t: count: cart.item_count }}
            {%- else -%}
              {{ 'sections.header.cart_count.other' | t: count: cart.item_count }}
            {%- endif -%}
          {%- else -%}
            {{ 'sections.header.cart' | t }}
          {%- endif -%}
        </span>
        <span class="caviera-header__cart-count" data-cart-count="{{ cart.item_count }}" aria-hidden="true">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
  <div class="caviera-header__localization container">
    {%- render 'localization-form', context: 'HeaderDesktop' -%}
  </div>
  {%- endif -%}
</caviera-header>

<div id="caviera-mobile-nav" class="caviera-mobile-nav" hidden>
  <div class="caviera-mobile-nav__head container">
    {%- comment -%}
      mode: 'dark' is correct here (renders the Bone-coloured seal) — this panel's background is a
      dark brand field (Cinnabar/Obsidian, see assets/caviera-header.css), never a light one. The
      previous 'light' value was a real, pre-existing contrast bug: it rendered the dark/Obsidian
      seal against an already-dark panel.
    {%- endcomment -%}
    <span class="caviera-mobile-nav__mark">{%- render 'caviera-house-seal', mode: 'dark', width: 40, alt: '' -%}</span>
    <button type="button" class="caviera-mobile-nav__close" data-caviera-menu-close aria-label="{{ 'general.accessibility.close_menu' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  {%- liquid
    assign edition_blocks = section.blocks | where: 'type', 'edition_nav_item'
    assign secondary_blocks = section.blocks | where: 'type', 'secondary_nav_item'
  -%}
  {%- comment -%}
    CAVIERA is Edition-based, not a category catalogue — this primary navigation is deliberately
    NOT the merchant's generic Shopify `main_menu` linklist (that setting still exists above for
    the retired/hidden inline desktop nav only). It's built from "Primary navigation item" blocks
    in the schema below, so the exact CURRENT EDITION / THE HOUSE / JOURNAL editorial structure the
    brief asks for is real, merchant-editable content — not hardcoded text with no way to change
    it later, and not a generic linklist that could drift toward a category-catalogue menu.
  {%- endcomment -%}
  {%- if edition_blocks.size > 0 -%}
  <div class="caviera-mobile-nav__room">
    <nav class="caviera-mobile-nav__nav container" aria-label="{{ 'sections.header.menu' | t }}">
      <ol>
        {%- for block in edition_blocks -%}
          {%- liquid
            assign index_label = forloop.index | prepend: '0' | slice: -2, 2
            assign primary_link = block.settings.link
            # Same-page anchor destinations (e.g. the homepage Edition I section, before it has its
            # own dedicated page — see sections/caviera-edition-teaser.liquid#edition-i) are
            # rebuilt from routes.root_url rather than trusted as a merchant-typed literal domain-
            # relative string, so this still resolves correctly on a locale-subfolder store
            # (routes.root_url is "/en" etc there, not always "/"). Any other destination (a real
            # page, once one exists) passes through untouched.
            if primary_link contains '#edition-i'
              assign primary_link = routes.root_url | append: '#edition-i'
            endif
            # Ceremonial-loader trigger: identified by this item's own configured title, not a
            # hardcoded URL — matches whatever "THE HOUSE" is actually pointed at right now (see
            # assets/caviera-header.js), so the destination itself is never duplicated/guessed here.
            assign is_house_link = false
            if block.settings.title == 'THE HOUSE'
              assign is_house_link = true
            endif
          -%}
          <li class="caviera-mobile-nav__item" data-primary-item="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="caviera-mobile-nav__primary-index" aria-hidden="true">{{ index_label }}</span>
            {%- if primary_link != blank -%}
              <a href="{{ primary_link }}" class="caviera-mobile-nav__primary-link"{% if is_house_link %} data-caviera-house-link{% endif %}>{{ block.settings.title }}</a>
            {%- else -%}
              {%- comment -%}
                No link configured — rendered as a quiet, honest "upcoming" entry rather than a
                broken or placeholder URL (e.g. Edition I before it has a dedicated page). Still
                focusable (tabindex 0, aria-disabled) so keyboard users can reach and read its
                status exactly as a mouse user would see it, even though activating it does nothing.
              {%- endcomment -%}
              <span class="caviera-mobile-nav__primary-link caviera-mobile-nav__primary-link--upcoming" tabindex="0" aria-disabled="true">{{ block.settings.title }}</span>
            {%- endif -%}
            {%- if block.settings.status_label != blank -%}
              <span class="caviera-mobile-nav__primary-status">{{ block.settings.status_label }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </nav>

    {%- comment -%}
      Reserved visual field (~right third) — quiet/empty by default. On hover or keyboard focus of
      a primary item (assets/caviera-header.css, `:has()`-based, no JS required) the matching image
      fades in. Merchant-uploaded `preview_image` always wins; otherwise a suitable bundled theme
      photo is used ONLY where one genuinely fits (Edition I → jewellery-on-model; The House →
      Oryx/architectural); no image exists for Journal, so that item's slot is simply omitted
      rather than showing an unrelated picture — the field just stays restrained for it, per brief.
    {%- endcomment -%}
    <div class="caviera-mobile-nav__preview" aria-hidden="true">
      {%- for block in edition_blocks -%}
        {%- liquid
          assign preview = block.settings.preview_image
          assign bundled_preview = blank
          assign bundled_w = 0
          assign bundled_h = 0
          case forloop.index
            when 1
              assign bundled_preview = '15_oryx_necklace_on_model.png'
              assign bundled_w = 521
              assign bundled_h = 358
            when 2
              assign bundled_preview = '26_oryx_palace_concept.png'
              assign bundled_w = 1672
              assign bundled_h = 941
          endcase
        -%}
        {%- if preview -%}
          <img
            class="caviera-mobile-nav__preview-image"
            data-preview-item="{{ forloop.index }}"
            src="{{ preview | image_url: width: 900 }}"
            srcset="{{ preview | image_url: width: 600 }} 600w, {{ preview | image_url: width: 900 }} 900w, {{ preview | image_url: width: 1200 }} 1200w"
            sizes="32vw"
            width="{{ preview.width }}"
            height="{{ preview.height }}"
            alt=""
            loading="lazy"
          >
        {%- elsif bundled_preview != blank -%}
          <img
            class="caviera-mobile-nav__preview-image"
            data-preview-item="{{ forloop.index }}"
            src="{{ bundled_preview | asset_url }}"
            width="{{ bundled_w }}"
            height="{{ bundled_h }}"
            alt=""
            loading="lazy"
          >
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- liquid
    assign has_multiple_markets = false
    if localization.available_countries.size > 1 or localization.available_languages.size > 1
      assign has_multiple_markets = true
    endif
    assign has_social = false
    if settings.social_instagram != blank or settings.social_pinterest != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank
      assign has_social = true
    endif
    assign show_mobile_localization = false
    if section.settings.enable_country_selector and has_multiple_markets
      assign show_mobile_localization = true
    endif
    assign show_mobile_utility = false
    if secondary_blocks.size > 0 or has_social or show_mobile_localization
      assign show_mobile_utility = true
    endif
  -%}
  {%- if show_mobile_utility -%}
    <div class="caviera-mobile-nav__utility container">
      {%- if secondary_blocks.size > 0 -%}
        <nav class="caviera-mobile-nav__secondary" aria-label="{{ 'sections.header.client_services' | t }}">
          <ul>
            {%- for block in secondary_blocks -%}
              <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}">{{ block.settings.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- if has_social -%}
        <div class="caviera-mobile-nav__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if show_mobile_localization -%}
        <div class="caviera-mobile-nav__localization">
          {%- render 'localization-form', context: 'HeaderMobile' -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
<div class="caviera-mobile-nav__scrim" data-caviera-menu-close hidden></div>

<script src="{{ 'caviera-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "main_menu", "label": "Menu", "default": "main-menu", "info": "Drives both the (hidden) legacy inline nav and the full-screen menu's primary navigation. Defaults to the store's standard \"main-menu\" navigation so the full-screen menu is never empty out of the box — change it any time to point at a different menu." },
    { "type": "checkbox", "id": "transparent_over_hero", "label": "Transparent over hero on homepage", "default": true },
    { "type": "checkbox", "id": "sticky_header", "label": "Sticky header on scroll", "default": true },
    {
      "type": "select", "id": "sticky_logo_mode", "label": "Sticky logo mode", "default": "seal",
      "options": [
        { "value": "wordmark", "label": "Keep full wordmark" },
        { "value": "seal", "label": "Transition to House Seal (recommended)" }
      ]
    },
    {
      "type": "select", "id": "resolved_scheme", "label": "Solid header colour", "default": "bone",
      "info": "Used whenever the header is not left transparent — its normal resting state, and what a transparent header resolves to once scrolled. Pair \"Obsidian\" with a Logo colour set to \"For dark backgrounds\" below.",
      "options": [
        { "value": "bone", "label": "Warm Bone (default)" },
        { "value": "obsidian", "label": "Obsidian" }
      ]
    },
    {
      "type": "select", "id": "logo_scheme", "label": "Logo colour version", "default": "light",
      "info": "Match this to the header's actual background. \"For light backgrounds\" shows the dark/obsidian wordmark (correct for the default solid Warm Bone header bar); \"For dark backgrounds\" shows the bone-coloured wordmark, for a header left transparent over a dark hero image.",
      "options": [
        { "value": "light", "label": "For light backgrounds" },
        { "value": "dark", "label": "For dark backgrounds" }
      ]
    },
    { "type": "range", "id": "logo_width_desktop", "label": "Desktop wordmark width", "min": 160, "max": 320, "step": 10, "default": 220, "unit": "px" },
    { "type": "range", "id": "logo_width_mobile", "label": "Mobile seal width", "min": 32, "max": 56, "step": 2, "default": 40, "unit": "px" },
    { "type": "checkbox", "id": "enable_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "enable_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "enable_country_selector", "label": "Show country/language selector", "default": false },
    { "type": "header", "content": "Mega menu" },
    { "type": "image_picker", "id": "megamenu_image", "label": "Default editorial image", "info": "Shown in every mega menu that has no matching \"Mega menu feature\" block below." },
    { "type": "header", "content": "Full-screen menu — primary navigation" },
    { "type": "paragraph", "content": "CAVIERA is Edition-based, not a category catalogue — add/reorder \"Primary navigation item\" blocks below rather than assigning a generic products/collections menu here. Numbering (01, 02, …) is automatic. Leave a block's Link blank to show it as a quiet \"upcoming\" entry with no click action, for content that doesn't exist yet (e.g. Edition I before it has a dedicated page)." },
    { "type": "header", "content": "Full-screen menu — secondary navigation" },
    { "type": "paragraph", "content": "Smaller secondary links (e.g. Craftsmanship, Our Diamonds, Bespoke, Client Care) — add \"Secondary navigation item\" blocks below. Social links and the localization control (if enabled above) appear alongside them automatically when configured." }
  ],
  "blocks": [
    {
      "type": "megamenu_feature",
      "name": "Mega menu feature",
      "settings": [
        { "type": "paragraph", "content": "Shopify menus have no way to attach a block directly to one item, so this matches by title instead — enter the exact top-level menu item title (e.g. \"Jewellery\") this feature should appear under." },
        { "type": "text", "id": "match_title", "label": "Menu item title to match" },
        {
          "type": "select", "id": "feature_type", "label": "Feature type", "default": "image",
          "options": [
            { "value": "image", "label": "Custom image" },
            { "value": "collection", "label": "Featured collection" },
            { "value": "article", "label": "Featured article" }
          ]
        },
        { "type": "collection", "id": "collection", "label": "Collection (when feature type is Collection)" },
        { "type": "article", "id": "article", "label": "Article (when feature type is Article)" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Required for Custom image; optional override for Collection/Article (their own featured image is used otherwise)." }
      ]
    },
    {
      "type": "edition_nav_item",
      "name": "Primary navigation item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "EDITION I" },
        { "type": "text", "id": "status_label", "label": "Status label (optional)", "info": "Small, quiet metadata under the title — e.g. \"UPCOMING — 2026\". Leave blank once the destination is live." },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave blank to render this item as a non-navigating \"upcoming\" entry instead of a broken or placeholder link." },
        { "type": "image_picker", "id": "preview_image", "label": "Preview image (optional)", "info": "Shown quietly in the reserved visual field when this item is hovered or keyboard-focused. Leave blank to fall back to a suitable bundled theme image where one genuinely fits, or to leave the field restrained where none does." }
      ]
    },
    {
      "type": "secondary_nav_item",
      "name": "Secondary navigation item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Craftsmanship" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "edition_nav_item", "settings": { "title": "EDITION I", "status_label": "UPCOMING — 2026", "link": "/#edition-i" } },
      { "type": "edition_nav_item", "settings": { "title": "THE HOUSE", "status_label": "", "link": "/pages/about-caviera" } },
      { "type": "edition_nav_item", "settings": { "title": "JOURNAL", "status_label": "", "link": "/blogs/news" } },
      { "type": "secondary_nav_item", "settings": { "title": "Craftsmanship", "link": "/pages/craftsmanship" } },
      { "type": "secondary_nav_item", "settings": { "title": "Our Diamonds", "link": "/pages/our-diamonds" } },
      { "type": "secondary_nav_item", "settings": { "title": "Bespoke", "link": "/pages/contact" } },
      { "type": "secondary_nav_item", "settings": { "title": "Client Care", "link": "/pages/contact" } }
    ]
  }
}
{% endschema %}
