{%- comment -%}
  Reusable editorial page hero — for The House, Craftsmanship, Bespoke, Contact, Journal and
  generic editorial pages. Distinct from sections/caviera-hero.liquid (the homepage's cinematic,
  product-fallback-driven hero): this one never pulls in an arbitrary product image when no media
  is selected — it simply uses a clean brand-colour field, since an editorial page hero isn't
  trying to sell a specific object.
{%- endcomment -%}
<section
  class="caviera-page-hero"
  data-scheme="{{ section.settings.color_scheme }}"
  data-height="{{ section.settings.height }}"
  data-align="{{ section.settings.text_align }}"
>
  {%- if section.settings.image_desktop or section.settings.image_mobile or section.settings.video_url -%}
    <div class="caviera-page-hero__media">
      {%- if section.settings.video_url != blank -%}
        <video class="caviera-page-hero__media-el caviera-page-hero__media-el--desktop" autoplay muted loop playsinline>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image_desktop -%}
        <img
          class="caviera-page-hero__media-el caviera-page-hero__media-el--desktop"
          src="{{ section.settings.image_desktop | image_url: width: 1920 }}"
          srcset="{{ section.settings.image_desktop | image_url: width: 960 }} 960w, {{ section.settings.image_desktop | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          width="{{ section.settings.image_desktop.width }}" height="{{ section.settings.image_desktop.height }}"
          alt="{{ section.settings.image_desktop.alt | default: '' | escape }}"
          loading="eager"
          style="object-position: {{ section.settings.image_desktop.presentation.focal_point | default: 'center' }};"
        >
      {%- endif -%}
      {%- if section.settings.image_mobile -%}
        <img
          class="caviera-page-hero__media-el caviera-page-hero__media-el--mobile"
          src="{{ section.settings.image_mobile | image_url: width: 900 }}"
          srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w, {{ section.settings.image_mobile | image_url: width: 900 }} 900w"
          sizes="100vw"
          width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}"
          alt="{{ section.settings.image_mobile.alt | default: '' | escape }}"
          loading="eager"
          style="object-position: {{ section.settings.image_mobile.presentation.focal_point | default: 'center' }};"
        >
      {%- endif -%}
      <div class="caviera-page-hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="container caviera-page-hero__content">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="heading-display">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="body-text--wide caviera-page-hero__intro">{{ section.settings.intro }}</div>{%- endif -%}
    {%- if section.settings.show_divider -%}<span class="caviera-page-hero__divider" aria-hidden="true"></span>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Short introduction" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "Set a focal point on the image itself in Shopify Admin to control cropping." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (falls back to desktop image)" },
    { "type": "text", "id": "video_url", "label": "Background video URL (MP4, muted, optional)" },
    {
      "type": "select", "id": "color_scheme", "label": "Colour", "default": "bone",
      "options": [
        { "value": "bone", "label": "Warm Bone" },
        { "value": "cinnabar", "label": "Cinnabar" },
        { "value": "obsidian", "label": "Obsidian" }
      ]
    },
    {
      "type": "select", "id": "text_align", "label": "Text alignment", "default": "start",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ]
    },
    {
      "type": "select", "id": "height", "label": "Height", "default": "compact",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "cinematic", "label": "Cinematic (near full-screen)" }
      ]
    },
    { "type": "checkbox", "id": "show_divider", "label": "Show thin Rhodium divider", "default": true }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
