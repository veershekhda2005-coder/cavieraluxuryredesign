<div class="caviera-page container container--narrow">
  <h1 class="heading-h1 caviera-customer__title">{{ 'customer.recover_password.title' | t }}</h1>
  <p class="body-text caviera-customer__subtext">{{ 'customer.recover_password.subtext' | t }}</p>
  {%- form 'recover_customer_password', class: 'caviera-customer__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-status" data-state="success">{{ 'customer.recover_password.success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="form-status" data-state="error">
        {%- for field in form.errors -%}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }} {%- endfor -%}
      </p>
    {%- endif -%}
    <div class="field">
      <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
      <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
    </div>
    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.recover_password.submit' | t }}</button>
  {%- endform -%}
</div>
